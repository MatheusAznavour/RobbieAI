# Robbie Environment Configuration Template
# Copy this file to `.env` and fill in values for your local environment.
# NEVER commit `.env` or real API keys to version control.

# -----------------------------------------------------------------------------
# Local Backend Server (FastAPI / Uvicorn)
# -----------------------------------------------------------------------------
# Host must remain strictly 127.0.0.1 for local security (0.0.0.0 is rejected).
ROBBIE_BACKEND_HOST=127.0.0.1
# Set to 0 to let the OS dynamically allocate an available ephemeral port (recommended).
ROBBIE_BACKEND_PORT=0
# Comma-separated allowed Origin headers for HTTP CORS and WebSocket handshakes.
ROBBIE_ALLOWED_ORIGINS=robbie://desktop
# Per-launch random bearer token. In desktop mode, Electron Main generates and
# injects this automatically into the sidecar process environment.
ROBBIE_API_TOKEN=
ROBBIE_LOG_LEVEL=INFO
# Leave blank to default to a user-local data directory (e.g., %LOCALAPPDATA%\Robbie)
ROBBIE_DATA_DIR=
# Optional overrides for locating the backend executable (used mainly in testing/packaging)
ROBBIE_BACKEND_BIN=
ROBBIE_BACKEND_PYTHON=

# -----------------------------------------------------------------------------
# Agent-S S3 — Main Worker Vision-Language Model (VLM)
# Supported engine types in Agent-S S3:
#   openai, anthropic, gemini, azure, open_router, vllm, ollama, deepseek, qwen, parasail
# -----------------------------------------------------------------------------
ROBBIE_WORKER_PROVIDER=openai
ROBBIE_WORKER_MODEL=gpt-5-2025-08-07
ROBBIE_WORKER_BASE_URL=
# Optional fixed temperature (leave blank for model default; some reasoning models require 1.0)
ROBBIE_WORKER_TEMPERATURE=
# Optional conversational HTTP timeout in seconds (5-120, default 40) and max output tokens (128-8192, default 2048)
ROBBIE_CHAT_TIMEOUT_SECONDS=
ROBBIE_CHAT_MAX_TOKENS=

# -----------------------------------------------------------------------------
# Agent-S S3 — Visual Grounding Model (Required for GUI coordinate prediction)
# Example: UI-TARS-1.5-7B (1920x1080) or UI-TARS-72B (1000x1000)
# -----------------------------------------------------------------------------
ROBBIE_GROUNDING_PROVIDER=huggingface
ROBBIE_GROUNDING_MODEL=ui-tars-1.5-7b
ROBBIE_GROUNDING_URL=
ROBBIE_GROUNDING_WIDTH=1920
ROBBIE_GROUNDING_HEIGHT=1080

# -----------------------------------------------------------------------------
# Agent-S Execution & Safety Defaults
# -----------------------------------------------------------------------------
ROBBIE_ENABLE_REFLECTION=true
ROBBIE_MAX_TRAJECTORY_LENGTH=8
# Keep false unless explicitly testing trusted code execution in a controlled environment.
ROBBIE_ENABLE_LOCAL_ENV=false

# -----------------------------------------------------------------------------
# Model Provider Credentials (fill only the providers you use)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
# Optional OpenAI-compatible base URL override (e.g., https://api.uncensoredllm.ai/v1)
OPENAI_BASE_URL=
OPENAI_ORG_ID=

ANTHROPIC_API_KEY=

GEMINI_API_KEY=
# Agent-S S3 Gemini engine uses the OpenAI-compatible Gemini endpoint:
GEMINI_ENDPOINT_URL=https://generativelanguage.googleapis.com/v1beta/openai/

OPENROUTER_API_KEY=
OPEN_ROUTER_ENDPOINT_URL=https://openrouter.ai/api/v1

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
OPENAI_API_VERSION=

HF_TOKEN=
HF_ENDPOINT_URL=

# Local inference servers (optional)
OLLAMA_HOST=http://127.0.0.1:11434
vLLM_ENDPOINT_URL=
vLLM_API_KEY=

# Optional native Tesseract binary path if not on system PATH (needed only for OCR text-span actions)
TESSERACT_CMD=
